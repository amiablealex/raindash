# /etc/nginx/sites-available/raindash
# Plain HTTP on purpose: the Kindle can't do modern TLS. It only serves PNGs.

# One line per Kindle fetch: time, IP, battery %, charging (1/0), script version, status
log_format raindash_heartbeat '$time_iso8601 $remote_addr bat=$arg_bat chg=$arg_chg v=$arg_v $status';

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/raindash;
    access_log off;

    location = /kindle.png {
        access_log /var/log/raindash/heartbeat.log raindash_heartbeat;
        add_header Cache-Control "no-cache";
    }
    location ~ ^/rain-[a-z]+\.png$ { add_header Cache-Control "no-cache"; }
    location / { return 404; }
}
